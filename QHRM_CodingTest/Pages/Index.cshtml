@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Products</h2>
        <a class="btn btn-primary" href="/Create">Add Product</a>
    </div>
    <table class="table table-striped table-responsive">
        <thead>
            <tr>
                <th>SrNo</th>
                <th>Name</th>
                <th>Description</th>
                <th>Price</th>
                <th>CreatedDate</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model.Products)
            {
                <tr>
                    <td>@p.RowNumber</td>
                    <td>@p.Name</td>
                    <td>@p.Description</td>
                    <td>@p.Price.ToString("C")</td>
                    <td>@p.CreatedDate.ToString("dd-MM-yyyy")</td>
                    <td>
                        <a class="btn btn-sm btn-secondary me-1" href="/Edit?id=@p.Id">Edit</a>
                        <a class="btn btn-sm btn-danger" href="/Delete?id=@p.Id">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>